# PostgreSQL connection string
# Use any Postgres provider: Supabase, Neon, Railway, or local
DATABASE_URL="postgresql://user:password@localhost:5432/rithtopup?schema=public"

# JWT secret for admin auth (generate: openssl rand -base64 32)
JWT_SECRET="change-this-to-a-long-random-string-at-least-32-chars"

# Admin bootstrap (used on first db:seed)
ADMIN_EMAIL="admin@tratopup.com"
ADMIN_PASSWORD="ChangeMeNow123!"

# Bakong KHQR (NBC Cambodia) — payments are made in KHR via one KHQR code that
# works in ABA, ACLEDA, Wing, TrueMoney and any other KHQR-compatible app.
#   BAKONG_ACCOUNT_ID    your Bakong account id, format name@bank (e.g. tra_dev@aba)
#   BAKONG_MERCHANT_NAME Latin letters, max 25 chars
#   BAKONG_TOKEN         token from the Bakong Open API (used to verify payments)
BAKONG_ACCOUNT_ID=""
BAKONG_MERCHANT_NAME=""
BAKONG_MERCHANT_CITY="PHNOM PENH"
BAKONG_TOKEN=""
# Set to 1 to log why Bakong did not confirm a payment (debug only)
BAKONG_DEBUG=""

# Telegram: a message is sent here whenever an order is paid
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# Base URL (no trailing slash)
NEXT_PUBLIC_BASE_URL="http://localhost:3000"

# Public https URL of the site (used for admin links in Telegram messages)
PUBLIC_APP_URL=""

# Simulation mode: when "true", payments auto-complete (for dev/demo). MUST be "false" in production.
PAYMENT_SIMULATION_MODE="true"
